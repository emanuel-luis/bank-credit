# Copy to .env and adjust. .env is gitignored; never commit real values.

# SQLAlchemy URL of the database.
DATABASE_URL=sqlite:///./bank_credit.db

# Required, at least 32 characters. The app refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-generated-key

# JWT signing algorithm and token lifetime.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Allowed browser origins (JSON list).
CORS_ORIGINS=["http://localhost:5173"]

# Email: when MAIL_ENABLED=false, emails are only written to the log.
MAIL_ENABLED=false
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=user@example.com
MAIL_PASSWORD=replace-me
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Sistema de Crédito Bancário

# Python logging level.
LOG_LEVEL=INFO
