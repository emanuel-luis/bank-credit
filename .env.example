# Copy to .env (or run `make env`, which fills the secrets). .env is gitignored.
# Docker Compose reads this file from the repo root.

# Postgres container and the credentials the API uses to reach it.
POSTGRES_USER=bank_credit
# Placeholder: set a strong value. `make env` generates one.
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=bank_credit

# Required, at least 32 characters. The API refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
#   or: openssl rand -hex 32
SECRET_KEY=replace-me-with-a-generated-key

# Password of the demo users created by `bank-credit seed`. Local demo only: never reuse it.
DEMO_PASSWORD=demo1234

# Host port (loopback only) for the Postgres container; used by `make test-integration`.
# POSTGRES_PORT=5433
